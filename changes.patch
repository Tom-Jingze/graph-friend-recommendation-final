+name: graph-friend-recommendation-v2
+
+x-spark-common: &spark-common
+  build:
+    context: .
+  image: graph-friend-recommendation-spark:3.5.7
+  init: true
+  working_dir: /app
+  volumes:
+    - type: bind
+      source: .
+      target: /app
+
+services:
+  spark-master:
+    <<: *spark-common
+    hostname: spark-master
+    command: ["/opt/spark/bin/spark-class", "org.apache.spark.deploy.master.Master", "--host", "spark-master", "--port", "7077", "--webui-port", "8080"]
+    ports:
+      - "127.0.0.1:8080:8080"
+    healthcheck:
+      test: ["CMD-SHELL", "bash -c '</dev/tcp/spark-master/7077'"]
+      interval: 3s
+      timeout: 3s
+      retries: 30
+      start_period: 10s
+
+  spark-worker-1:
+    <<: *spark-common
+    hostname: spark-worker-1
