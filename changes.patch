+      spark-master:
+        condition: service_healthy
+
+  spark-worker-2:
+    <<: *spark-common
+    hostname: spark-worker-2
+    command: ["/opt/spark/bin/spark-class", "org.apache.spark.deploy.worker.Worker", "--host", "spark-worker-2", "--cores", "1", "--memory", "1g", "--webui-port", "8081", "spark://spark-master:7077"]
+    ports:
+      - "127.0.0.1:8082:8081"
+    depends_on:
+      spark-master:
+        condition: service_healthy
+
+  submit:
+    <<: *spark-common
+    hostname: submit
+    profiles: ["tools"]
+    command:
+      - /opt/spark/bin/spark-submit
+      - --master
+      - spark://spark-master:7077
+      - --deploy-mode
+      - client
+      - --driver-memory
+      - 1g
+      - --executor-memory
+      - 768m
+      - --conf
+      - spark.cores.max=2
+      - --conf
+      - spark.driver.host=submit
+      - --conf
+      - spark.driver.bindAddress=0.0.0.0
+      - --conf
+      - spark.driver.port=7078
+      - --conf
+      - spark.blockManager.port=7079
+      - /app/src/spark_pipeline.py
+      - --master
+      - spark://spark-master:7077
+      - --input
+      - /app/${GRAPH_INPUT:-data/facebook_combined.txt.gz}
+      - --output
+      - /app/${GRAPH_OUTPUT:-artifacts/docker}
+      - --run-id
+      - ${RUN_ID:-docker-demo-001}
+      - --format
+      - ${TABLE_FORMAT:-parquet}
+      - --mode
+      - ${MODE:-baseline}
+      - --partitions
+      - ${SHUFFLE_PARTITIONS:-4}
+      - --max-wedges
+      - ${MAX_WEDGES:-50000000}
+      - --iceberg-package=
+    ports:
